PORT=3001
# Atlas: mongodb+srv://USUARIO:CONTRASEÑA@CLUSTER.mongodb.net/casa-de-los-vientos?appName=NOMBRE
MONGO_URI=

# Origen exacto del sitio (sin barra final). En desarrollo, el front de Vite.
ALLOWED_ORIGIN=http://localhost:5173
# Cuántos proxies hay delante (Nginx = 1). 0 en desarrollo.
TRUST_PROXY=0

# Carpeta donde el script deja las fotos procesadas y que Express sirve en /photos.
# En producción: una ruta fuera de la app, ej. /var/www/casa-fotos
PHOTOS_DIR=./storage/photos
# Se antepone a las rutas de las fotos. Vacío = rutas relativas (mismo origen). Con CDN: https://cdn...
PUBLIC_BASE_URL=

# Mail (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="La Casa de los Vientos <web@casadelosvientos.com.ar>"
# Destino de las consultas: confirmar con los dueños
MAIL_TO=reservas@casadelosvientos.com.ar
# Solo desarrollo: true = no manda mail real (jsonTransport) y lo muestra por consola
MAIL_DRY_RUN=false
